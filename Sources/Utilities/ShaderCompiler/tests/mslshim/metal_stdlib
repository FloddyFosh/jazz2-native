// Minimal stand-in for Apple's <metal_stdlib>, used ONLY to type-check the MSL the ShaderCompiler emits with
// an ordinary clang on Linux (there is no MSL compiler outside Xcode). It models the subset the emitter
// produces: the vector/matrix types (clang ext_vector_type gives swizzles and component-wise operators),
// the texture/sampler objects, the address-space keywords and the built-in functions. Attributes like
// [[position]] / [[buffer(0)]] are unknown to clang and simply ignored (-Wno-unknown-attributes). This is a
// proxy check, not Apple's compiler: it catches undeclared names, arity/type mismatches, bad swizzles, wrong
// member names and malformed declarations, but not MSL-only semantic rules.
#pragma once

#include <cmath>
#include <cstdint>
#include <type_traits>

#define vertex
#define fragment
#define kernel
#define constant const
#define device
#define thread
#define threadgroup

namespace metal
{
	typedef unsigned int uint;
	typedef unsigned short ushort;
	typedef unsigned char uchar;

	typedef float float2 __attribute__((ext_vector_type(2)));
	typedef float float3 __attribute__((ext_vector_type(3)));
	typedef float float4 __attribute__((ext_vector_type(4)));
	typedef int int2 __attribute__((ext_vector_type(2)));
	typedef int int3 __attribute__((ext_vector_type(3)));
	typedef int int4 __attribute__((ext_vector_type(4)));
	typedef unsigned int uint2 __attribute__((ext_vector_type(2)));
	typedef unsigned int uint3 __attribute__((ext_vector_type(3)));
	typedef unsigned int uint4 __attribute__((ext_vector_type(4)));
	// Comparisons on ext vectors yield int vectors in clang, so the bool vectors are int vectors here
	typedef int bool2 __attribute__((ext_vector_type(2)));
	typedef int bool3 __attribute__((ext_vector_type(3)));
	typedef int bool4 __attribute__((ext_vector_type(4)));
	typedef float3 packed_float3;
	typedef int3 packed_int3;
	typedef uint3 packed_uint3;

	// ---- constructors (the harness rewrites "float4(" -> "mk_float4(" etc. before compiling) ----

	template<class T> struct vec_traits { static constexpr int size = 1; };
	template<> struct vec_traits<float2> { static constexpr int size = 2; };
	template<> struct vec_traits<float3> { static constexpr int size = 3; };
	template<> struct vec_traits<float4> { static constexpr int size = 4; };
	template<> struct vec_traits<int2> { static constexpr int size = 2; };
	template<> struct vec_traits<int3> { static constexpr int size = 3; };
	template<> struct vec_traits<int4> { static constexpr int size = 4; };
	template<> struct vec_traits<uint2> { static constexpr int size = 2; };
	template<> struct vec_traits<uint3> { static constexpr int size = 3; };
	template<> struct vec_traits<uint4> { static constexpr int size = 4; };

	template<class S> inline float mk_float(S x) { return (float)x; }
	template<class S> inline int mk_int(S x) { return (int)x; }
	template<class S> inline uint mk_uint(S x) { return (uint)x; }
	template<class S> inline bool mk_bool(S x) { return (bool)x; }

#define MK_VEC2(V, E) \
	template<class S> inline auto mk_##V(S x) -> std::enable_if_t<std::is_arithmetic<S>::value, V> { return V{(E)x, (E)x}; } \
	template<class W> inline auto mk_##V(W v) -> std::enable_if_t<vec_traits<W>::size == 2, V> { return __builtin_convertvector(v, V); } \
	template<class A, class B> inline auto mk_##V(A a, B b) -> std::enable_if_t<std::is_arithmetic<A>::value && std::is_arithmetic<B>::value, V> { return V{(E)a, (E)b}; }
#define MK_VEC3(V, V2, E) \
	template<class S> inline auto mk_##V(S x) -> std::enable_if_t<std::is_arithmetic<S>::value, V> { return V{(E)x, (E)x, (E)x}; } \
	template<class W> inline auto mk_##V(W v) -> std::enable_if_t<vec_traits<W>::size == 3, V> { return __builtin_convertvector(v, V); } \
	template<class A, class B, class C> inline auto mk_##V(A a, B b, C c) -> std::enable_if_t<std::is_arithmetic<A>::value && std::is_arithmetic<B>::value && std::is_arithmetic<C>::value, V> { return V{(E)a, (E)b, (E)c}; } \
	template<class W, class B> inline auto mk_##V(W ab, B c) -> std::enable_if_t<vec_traits<W>::size == 2 && std::is_arithmetic<B>::value, V> { return V{(E)ab.x, (E)ab.y, (E)c}; } \
	template<class A, class W> inline auto mk_##V(A a, W bc) -> std::enable_if_t<std::is_arithmetic<A>::value && vec_traits<W>::size == 2, V> { return V{(E)a, (E)bc.x, (E)bc.y}; }
#define MK_VEC4(V, E) \
	template<class S> inline auto mk_##V(S x) -> std::enable_if_t<std::is_arithmetic<S>::value, V> { return V{(E)x, (E)x, (E)x, (E)x}; } \
	template<class W> inline auto mk_##V(W v) -> std::enable_if_t<vec_traits<W>::size == 4, V> { return __builtin_convertvector(v, V); } \
	template<class A, class B, class C, class D> inline auto mk_##V(A a, B b, C c, D d) -> std::enable_if_t<std::is_arithmetic<A>::value && std::is_arithmetic<B>::value && std::is_arithmetic<C>::value && std::is_arithmetic<D>::value, V> { return V{(E)a, (E)b, (E)c, (E)d}; } \
	template<class W, class C, class D> inline auto mk_##V(W ab, C c, D d) -> std::enable_if_t<vec_traits<W>::size == 2 && std::is_arithmetic<C>::value && std::is_arithmetic<D>::value, V> { return V{(E)ab.x, (E)ab.y, (E)c, (E)d}; } \
	template<class A, class W, class D> inline auto mk_##V(A a, W bc, D d) -> std::enable_if_t<std::is_arithmetic<A>::value && vec_traits<W>::size == 2 && std::is_arithmetic<D>::value, V> { return V{(E)a, (E)bc.x, (E)bc.y, (E)d}; } \
	template<class A, class B, class W> inline auto mk_##V(A a, B b, W cd) -> std::enable_if_t<std::is_arithmetic<A>::value && std::is_arithmetic<B>::value && vec_traits<W>::size == 2, V> { return V{(E)a, (E)b, (E)cd.x, (E)cd.y}; } \
	template<class W, class X> inline auto mk_##V(W ab, X cd) -> std::enable_if_t<vec_traits<W>::size == 2 && vec_traits<X>::size == 2, V> { return V{(E)ab.x, (E)ab.y, (E)cd.x, (E)cd.y}; } \
	template<class W, class D> inline auto mk_##V(W abc, D d) -> std::enable_if_t<vec_traits<W>::size == 3 && std::is_arithmetic<D>::value, V> { return V{(E)abc.x, (E)abc.y, (E)abc.z, (E)d}; } \
	template<class A, class W> inline auto mk_##V(A a, W bcd) -> std::enable_if_t<std::is_arithmetic<A>::value && vec_traits<W>::size == 3, V> { return V{(E)a, (E)bcd.x, (E)bcd.y, (E)bcd.z}; }

	MK_VEC2(float2, float) MK_VEC3(float3, float2, float) MK_VEC4(float4, float)
	MK_VEC2(int2, int) MK_VEC3(int3, int2, int) MK_VEC4(int4, int)
	MK_VEC2(uint2, uint) MK_VEC3(uint3, uint2, uint) MK_VEC4(uint4, uint)
	MK_VEC2(bool2, int) MK_VEC3(bool3, bool2, int) MK_VEC4(bool4, int)

	// ---- matrices (column-major, like MSL/GLSL) ----

	struct float2x2 { float2 c[2]; float2& operator[](int i) { return c[i]; } const float2& operator[](int i) const { return c[i]; } };
	struct float3x3 { float3 c[3]; float3& operator[](int i) { return c[i]; } const float3& operator[](int i) const { return c[i]; } };
	struct float4x4 { float4 c[4]; float4& operator[](int i) { return c[i]; } const float4& operator[](int i) const { return c[i]; } };

	inline float2x2 mk_float2x2(float2 a, float2 b) { return float2x2{{a, b}}; }
	inline float2x2 mk_float2x2(float d) { return float2x2{{{d, 0}, {0, d}}}; }
	inline float2x2 mk_float2x2(const float2x2& m) { return m; }
	inline float3x3 mk_float3x3(float3 a, float3 b, float3 c) { return float3x3{{a, b, c}}; }
	inline float3x3 mk_float3x3(float d) { return float3x3{{{d, 0, 0}, {0, d, 0}, {0, 0, d}}}; }
	inline float3x3 mk_float3x3(const float3x3& m) { return m; }
	inline float3x3 mk_float3x3(float a, float b, float c, float d, float e, float f, float g, float h, float i) { return float3x3{{{a, b, c}, {d, e, f}, {g, h, i}}}; }
	inline float4x4 mk_float4x4(float4 a, float4 b, float4 c, float4 d) { return float4x4{{a, b, c, d}}; }
	inline float4x4 mk_float4x4(float d) { return float4x4{{{d, 0, 0, 0}, {0, d, 0, 0}, {0, 0, d, 0}, {0, 0, 0, d}}}; }
	inline float4x4 mk_float4x4(const float4x4& m) { return m; }

	inline float2 operator*(const float2x2& m, float2 v) { return m.c[0] * v.x + m.c[1] * v.y; }
	inline float3 operator*(const float3x3& m, float3 v) { return m.c[0] * v.x + m.c[1] * v.y + m.c[2] * v.z; }
	inline float4 operator*(const float4x4& m, float4 v) { return m.c[0] * v.x + m.c[1] * v.y + m.c[2] * v.z + m.c[3] * v.w; }
	inline float2 operator*(float2 v, const float2x2& m) { return float2{v.x * m.c[0].x + v.y * m.c[0].y, v.x * m.c[1].x + v.y * m.c[1].y}; }
	inline float3 operator*(float3 v, const float3x3& m) { float3 r; for (int i = 0; i < 3; i++) r[i] = v.x * m.c[i].x + v.y * m.c[i].y + v.z * m.c[i].z; return r; }
	inline float4 operator*(float4 v, const float4x4& m) { float4 r; for (int i = 0; i < 4; i++) r[i] = v.x * m.c[i].x + v.y * m.c[i].y + v.z * m.c[i].z + v.w * m.c[i].w; return r; }
	inline float2x2 operator*(const float2x2& a, const float2x2& b) { return float2x2{{a * b.c[0], a * b.c[1]}}; }
	inline float3x3 operator*(const float3x3& a, const float3x3& b) { return float3x3{{a * b.c[0], a * b.c[1], a * b.c[2]}}; }
	inline float4x4 operator*(const float4x4& a, const float4x4& b) { return float4x4{{a * b.c[0], a * b.c[1], a * b.c[2], a * b.c[3]}}; }
	inline float3x3 operator*(const float3x3& a, float s) { return float3x3{{a.c[0] * s, a.c[1] * s, a.c[2] * s}}; }
	inline float4x4 operator*(const float4x4& a, float s) { return float4x4{{a.c[0] * s, a.c[1] * s, a.c[2] * s, a.c[3] * s}}; }
	inline float3x3 operator*(float s, const float3x3& a) { return a * s; }
	inline float4x4 operator*(float s, const float4x4& a) { return a * s; }
	inline float3x3 transpose(const float3x3& m) { float3x3 r; for (int i = 0; i < 3; i++) for (int j = 0; j < 3; j++) r.c[i][j] = m.c[j][i]; return r; }
	inline float4x4 transpose(const float4x4& m) { float4x4 r; for (int i = 0; i < 4; i++) for (int j = 0; j < 4; j++) r.c[i][j] = m.c[j][i]; return r; }
	inline float2x2 transpose(const float2x2& m) { float2x2 r; for (int i = 0; i < 2; i++) for (int j = 0; j < 2; j++) r.c[i][j] = m.c[j][i]; return r; }
	inline float determinant(const float2x2& m) { return m.c[0].x * m.c[1].y - m.c[1].x * m.c[0].y; }
	inline float determinant(const float3x3& m) { return 0.0f * m.c[0].x; }
	inline float determinant(const float4x4& m) { return 0.0f * m.c[0].x; }

