	// ---- built-in functions ----

	// Component-wise lifting of a scalar function over the float vectors
#define LIFT1(F, IMPL) \
	inline float F(float x) { return IMPL(x); } \
	inline float2 F(float2 v) { float2 r; for (int i = 0; i < 2; i++) r[i] = IMPL(v[i]); return r; } \
	inline float3 F(float3 v) { float3 r; for (int i = 0; i < 3; i++) r[i] = IMPL(v[i]); return r; } \
	inline float4 F(float4 v) { float4 r; for (int i = 0; i < 4; i++) r[i] = IMPL(v[i]); return r; }
#define LIFT2(F, IMPL) \
	inline float F(float a, float b) { return IMPL(a, b); } \
	inline float2 F(float2 a, float2 b) { float2 r; for (int i = 0; i < 2; i++) r[i] = IMPL(a[i], b[i]); return r; } \
	inline float3 F(float3 a, float3 b) { float3 r; for (int i = 0; i < 3; i++) r[i] = IMPL(a[i], b[i]); return r; } \
	inline float4 F(float4 a, float4 b) { float4 r; for (int i = 0; i < 4; i++) r[i] = IMPL(a[i], b[i]); return r; } \
	inline float2 F(float2 a, float b) { float2 r; for (int i = 0; i < 2; i++) r[i] = IMPL(a[i], b); return r; } \
	inline float3 F(float3 a, float b) { float3 r; for (int i = 0; i < 3; i++) r[i] = IMPL(a[i], b); return r; } \
	inline float4 F(float4 a, float b) { float4 r; for (int i = 0; i < 4; i++) r[i] = IMPL(a[i], b); return r; }

	inline float s_fract(float x) { return x - std::floor(x); }
	inline float s_rsqrt(float x) { return 1.0f / std::sqrt(x); }
	inline float s_saturate(float x) { return x < 0 ? 0 : (x > 1 ? 1 : x); }
	inline float s_sign(float x) { return x > 0 ? 1.0f : (x < 0 ? -1.0f : 0.0f); }
	inline float s_step(float e, float x) { return x < e ? 0.0f : 1.0f; }
	inline float s_min(float a, float b) { return a < b ? a : b; }
	inline float s_max(float a, float b) { return a > b ? a : b; }
	inline float s_ident(float x) { return x; }

	LIFT1(sin, std::sin) LIFT1(cos, std::cos) LIFT1(tan, std::tan) LIFT1(asin, std::asin) LIFT1(acos, std::acos) LIFT1(atan, std::atan)
	LIFT1(sinh, std::sinh) LIFT1(cosh, std::cosh) LIFT1(tanh, std::tanh)
	LIFT1(exp, std::exp) LIFT1(exp2, std::exp2) LIFT1(log, std::log) LIFT1(log2, std::log2) LIFT1(sqrt, std::sqrt)
	LIFT1(floor, std::floor) LIFT1(ceil, std::ceil) LIFT1(round, std::round) LIFT1(trunc, std::trunc)
	LIFT1(fract, s_fract) LIFT1(rsqrt, s_rsqrt) LIFT1(saturate, s_saturate) LIFT1(sign, s_sign)
	LIFT1(dfdx, s_ident) LIFT1(dfdy, s_ident) LIFT1(fwidth, s_ident) LIFT1(normalize, s_ident)
	LIFT2(pow, std::pow) LIFT2(atan2, std::atan2) LIFT2(fmod, std::fmod) LIFT2(step, s_step)
	LIFT2(min, s_min) LIFT2(max, s_max)

	inline float abs(float x) { return std::fabs(x); }
	inline float2 abs(float2 v) { float2 r; for (int i = 0; i < 2; i++) r[i] = std::fabs(v[i]); return r; }
	inline float3 abs(float3 v) { float3 r; for (int i = 0; i < 3; i++) r[i] = std::fabs(v[i]); return r; }
	inline float4 abs(float4 v) { float4 r; for (int i = 0; i < 4; i++) r[i] = std::fabs(v[i]); return r; }
	inline int abs(int x) { return x < 0 ? -x : x; }
	inline int2 abs(int2 v) { return v; }
	inline int3 abs(int3 v) { return v; }
	inline int4 abs(int4 v) { return v; }
	inline int min(int a, int b) { return a < b ? a : b; }
	inline int max(int a, int b) { return a > b ? a : b; }
	inline uint min(uint a, uint b) { return a < b ? a : b; }
	inline uint max(uint a, uint b) { return a > b ? a : b; }
	inline int2 min(int2 a, int2 b) { return a; } inline int3 min(int3 a, int3 b) { return a; } inline int4 min(int4 a, int4 b) { return a; }
	inline int2 max(int2 a, int2 b) { return a; } inline int3 max(int3 a, int3 b) { return a; } inline int4 max(int4 a, int4 b) { return a; }
	inline int clamp(int x, int lo, int hi) { return x < lo ? lo : (x > hi ? hi : x); }
	inline uint clamp(uint x, uint lo, uint hi) { return x < lo ? lo : (x > hi ? hi : x); }
	inline int2 clamp(int2 x, int2 lo, int2 hi) { return x; } inline int3 clamp(int3 x, int3 lo, int3 hi) { return x; } inline int4 clamp(int4 x, int4 lo, int4 hi) { return x; }
	inline int2 clamp(int2 x, int lo, int hi) { return x; } inline int3 clamp(int3 x, int lo, int hi) { return x; } inline int4 clamp(int4 x, int lo, int hi) { return x; }

	inline float clamp(float x, float lo, float hi) { return s_min(s_max(x, lo), hi); }
	inline float2 clamp(float2 x, float2 lo, float2 hi) { return min(max(x, lo), hi); }
	inline float3 clamp(float3 x, float3 lo, float3 hi) { return min(max(x, lo), hi); }
